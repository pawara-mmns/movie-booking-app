VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:8000
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres

# PayHere Sandbox — keep these server-side only.
PAYHERE_MERCHANT_ID=YOUR_SANDBOX_MERCHANT_ID
PAYHERE_MERCHANT_SECRET=YOUR_SANDBOX_MERCHANT_SECRET
FRONTEND_PUBLIC_URL=http://localhost:5173
# PayHere cannot notify localhost. Use the public HTTPS URL of this FastAPI server/tunnel.
BACKEND_PUBLIC_URL=https://YOUR-PUBLIC-BACKEND.example.com
CORS_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.example.com
