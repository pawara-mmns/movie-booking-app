{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },

    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*",
      "service": "backend"
    },
    {
      "source": "/:path*",
      "destination": "/:path*",
      "service": "frontend"
    }
  ]
}